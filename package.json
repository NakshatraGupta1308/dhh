{
  "name": "dhh-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "An interactive explorer for the Desi Hip Hop scene: timeline, artists, labels and scenes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate-data && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "validate-data": "node data-scripts/validate.mjs"
  },
  "dependencies": {
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
